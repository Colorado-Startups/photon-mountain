---
// The endorsement lockup: the project mark and name, then the fixed line "a Colorado Startups project",
// then the joint-effort line. Brand rule: Colorado Startups first, then Colorado Compute; never a coalition,
// never a merged mark (Colorado-Startups/brand data/architecture.yaml, lockups.endorsement and colorado-compute).
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <div class="lockup">
      <img src="/favicon.svg" alt="" width="40" height="40" />
      <div>
        <p class="name">Photon Mountain</p>
        <p class="line"><a href="https://coloradostartups.org/">a Colorado Startups project</a></p>
        <p class="line">A joint effort with <a href="https://coloradoai.us/">Colorado Compute</a></p>
      </div>
    </div>
    <p class="meta">
      Open data, CC0 1.0. Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>, ODbL.
      <a href="https://github.com/Colorado-Startups/photon-mountain">Source</a> · {year}
    </p>
  </div>
</footer>
<style>
  .site-footer { border-top: var(--hairline) solid var(--rule); margin-top: 4rem; padding-block: 2rem 3rem; }
  .row { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; justify-content: space-between; align-items: flex-start; }
  .lockup { display: flex; gap: 0.75rem; align-items: center; }
  .lockup img { width: 2.5rem; height: 2.5rem; }
  .name { font-family: var(--font-display); font-weight: 700; font-size: var(--step2); }
  .line, .meta { color: var(--ink-2); font-size: var(--step0); }
  .line a, .meta a { color: inherit; }
  .meta { max-width: 26rem; }
</style>
