---
// Silicon Valley was named for the material of the last computing era; Photon Mountain for the medium of the
// next. The two cores drawn to one scale, from the comparison maps' measured diameters.
import { CORES, DOC, scaled } from "../../lib/versus";

const share = Object.fromEntries(scaled().map((s) => [s.id, s.share]));
---
<section class="versus wrap" aria-labelledby="versus-title" data-section="versus">
  <p class="eyebrow">Material and medium</p>
  <h2 id="versus-title">Silicon Valley, meet Photon Mountain</h2>
  <ul class="pair" role="list">
    {CORES.map((c) => (
      <li class={`core core-${c.id}`}>
        <span class="tile" aria-hidden="true">{c.element}</span>
        <div class="body">
          <p class="name">{c.name}</p>
          <p class="what">{c.what}</p>
          <div class="bar" style={`--share: ${share[c.id]}`} role="img" aria-label={`Core length ${c.miles} miles, ${c.from} to ${c.to}`}>
            <span class="end">{c.from}</span>
            <span class="line"></span>
            <span class="end">{c.to}</span>
          </div>
          <p class="miles"><b>{c.miles.toFixed(1)}</b> miles, core to core</p>
        </div>
      </li>
    ))}
  </ul>
  <p class="note">Bars at one scale. Diameters measured by the comparison maps' verify script; <a href={`https://github.com/Colorado-Startups/photon-mountain/blob/main/${DOC}`}>method and record</a>.</p>
</section>

<style>
  .versus { display: grid; gap: 1rem; padding-block: 3rem 4rem; }
  .pair { display: grid; gap: 1rem; padding: 0; margin: 0.5rem 0 0; list-style: none; }
  .core { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1.25rem; align-items: center; padding: 1.25rem; border-radius: 1rem; border: var(--hairline) solid var(--rule); background: var(--surface); }
  .tile { display: grid; place-items: center; width: 5.5rem; height: 5.5rem; border-radius: 0.75rem; font: 700 var(--step6) / 1 var(--font-display); background: var(--ground); color: var(--ink-2); border: 0.125rem solid var(--rule); }
  .core-pm .tile { background: var(--ink); color: var(--gold); border-color: var(--gold); box-shadow: 0 0 1.5rem 0.25rem var(--gold-wash); }
  .name { font: 700 var(--step3) var(--font-display); }
  .what { color: var(--ink-2); }
  .bar { display: flex; align-items: center; gap: 0.5rem; width: calc(var(--share) * 100%); margin-top: 0.75rem; font-size: var(--step0); color: var(--ink-2); }
  .line { flex: 1; height: 0.375rem; border-radius: 999rem; background: var(--rule); }
  .core-pm .line { background: linear-gradient(90deg, var(--gold), var(--color-laser-violet)); }
  .miles { margin-top: 0.25rem; color: var(--ink-2); }
  .miles b { font: 700 var(--step4) var(--font-display); color: var(--ink); font-variant-numeric: tabular-nums; }
  .note { color: var(--ink-2); font-size: var(--step0); }
</style>
