#!/usr/bin/env bash
# Photon Mountain pre-commit gate.
#
# ---------------------------------------------------------------------------
# POLICY (decided 2026-09-22, after researching current practice; rerouted
# 2026-10-08 when voice_lint.py was adopted from Claude-OS)
#
#   BLOCK on any FAIL finding from the voice lint.
#     This hook routes; it does not grade. voice_lint.py decides every grade,
#     and pm-check-voice.sh exits 1 only when the lint printed a FAIL. This
#     hook blocks on that exit code and names no check, so a regrade upstream
#     needs no edit here. As of 2026-10-08 the FAIL checks are em-dash and
#     spaced-en-dash: literal character tests with no false positives.
#
#   WARN on every WARN finding.
#     As of 2026-10-08 that is unattributed-figure, ai-tell, hedge-word and
#     sentence-length. voice_lint.py's own docstring calls them heuristics.
#     Blocking on a heuristic trains people to reach for --no-verify, which
#     costs more than it saves.
#
#   FAIL OPEN when the checker itself cannot run.
#     A missing python3 or a missing script warns and lets the commit
#     through. "Could not verify" is not the same as "verified and red".
#
# The rule of thumb behind this split: block on fast, deterministic,
# auto-fixable things; warn on slow or probabilistic ones; put the real gate
# server-side. That last part is why this hook matters more here than it
# would elsewhere. While the repo is private on a Free org, GitHub will not
# let CI be a required check, so this hook is the only gate that actually
# stops anything.
#
# ESCAPE HATCH:  git commit --no-verify
#     Deliberate, documented, and yours. A PreToolUse hook denies that flag
#     to Claude (see .claude/settings.json), so the agent cannot route around
#     the gate while you still can.
#
# ENABLE (once per clone):  git config core.hooksPath .githooks
# ---------------------------------------------------------------------------

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VOICE_HOOK="$REPO_ROOT/.claude/hooks/pm-check-voice.sh"

staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0

blocked=0
warned=0

# --- 1. Secret scan -------------------------------------------------------
# gitleaks if it is installed, skipped silently otherwise. The authoritative
# gate is secret-scan.yml in CI; this is the earlier, local warning.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gl_out="$(gitleaks git --staged --no-banner --redact=100 2>&1)"; then
    warned=1
    {
      echo
      echo "=============================================="
      echo "pre-commit: POSSIBLE SECRET in the staged diff"
      echo "=============================================="
      echo "$gl_out" | tail -30
      echo
      echo "Advisory: the commit will proceed. Do NOT push until you have"
      echo "confirmed this is not a real credential. If it is real, unstage"
      echo "it and rotate the secret."
    } >&2
  fi
fi

# --- 2. Voice gate --------------------------------------------------------
# Invoked as `bash <hook>`, never by exec bit, so a checkout or a sync that
# strips the executable bit cannot silently disable the check.
if [ -r "$VOICE_HOOK" ]; then
  # Pass the staged prose through; the hook self-filters by extension.
  prose=()
  while IFS= read -r f; do
    [ -n "$f" ] && prose+=("$REPO_ROOT/$f")
  done <<< "$staged"

  if [ "${#prose[@]}" -gt 0 ]; then
    voice_out="$(bash "$VOICE_HOOK" "${prose[@]}" 2>&1)"
    voice_status=$?
    if [ -n "$voice_out" ]; then
      # Exit 1 blocks. pm-check-voice.sh returns it only for a real FAIL
      # finding, never for a crash. Everything else is advisory.
      if [ "$voice_status" -eq 1 ]; then
        blocked=1
        {
          echo
          echo "========================================"
          echo "pre-commit: voice FAIL in a staged file"
          echo "========================================"
          printf '%s\n' "$voice_out" | grep -E ':[0-9]+: FAIL \['
          echo
          echo "Each finding above says what to change."
          echo
          echo "This commit is blocked. To override anyway:"
          echo "    git commit --no-verify"
        } >&2
      fi
      if printf '%s' "$voice_out" | grep -qE ':[0-9]+: WARN \['; then
        warned=1
        advisories="$(printf '%s\n' "$voice_out" | grep -E ':[0-9]+: WARN \[')"
        total="$(printf '%s\n' "$advisories" | grep -c .)"
        # Cap the dump. A dense revision log can produce ninety warnings in one
        # commit, and a wall of text is not actionable: it buries the one
        # finding worth acting on and teaches people to skip the output. Show
        # unattributed figures first, since those are the ones that matter, then
        # a sample of the rest with a count.
        {
          echo
          echo "pre-commit: $total voice finding(s), advisory, not blocking."
          printf '%s\n' "$advisories" | grep "unattributed-figure" | head -10
          printf '%s\n' "$advisories" | grep -v "unattributed-figure" | head -8
          if [ "$total" -gt 18 ]; then
            echo "    ... and $((total - 18)) more. Full list:"
            echo "    python3 04_tools/voice_lint.py <file>"
          fi
          echo
          echo "Warnings are heuristics, so wave through anything the lint"
          echo "misread. A figure still needs a source or a goal label; the"
          echo "lint warns on it, but the rule does not soften."
        } >&2
      fi
      # The gate's own notices, such as a could-not-verify after a crash. It
      # fails open, so without this line the skip would be silent.
      if printf '%s\n' "$voice_out" | grep -q '^pm-check-voice: '; then
        warned=1
        printf '%s\n' "$voice_out" | grep '^pm-check-voice: ' >&2
      fi
    fi
  fi
else
  echo "pre-commit: $VOICE_HOOK not readable; skipping the voice check." >&2
fi

# --- 3. Gate self-tests, when a gate itself changed -----------------------
# A broken gate is worse than no gate, so if a gate changed, prove it still
# passes its own self-test before the change can land.
if printf '%s' "$staged" | grep -qE "^\.claude/hooks/|^04_tools/voice_exempt\.txt"; then
  for shell_gate in pm-check-voice.sh pm-guard-bypass.sh; do
    script="$REPO_ROOT/.claude/hooks/$shell_gate"
    [ -r "$script" ] || continue
    if ! out="$(bash "$script" --self-test 2>&1)"; then
      blocked=1
      {
        echo
        echo "pre-commit: $shell_gate --self-test FAILED"
        echo "$out" | tail -15
        echo
        echo "A gate that does not pass its own self-test cannot be trusted."
        echo "This commit is blocked."
      } >&2
    fi
  done
fi

if printf '%s' "$staged" | grep -q "^04_tools/" && command -v python3 >/dev/null 2>&1; then
  for tool in voice_lint brand_tokens marker_parity; do
    script="$REPO_ROOT/04_tools/$tool.py"
    [ -r "$script" ] || continue
    if ! out="$(python3 "$script" --self-test 2>&1)"; then
      blocked=1
      {
        echo
        echo "pre-commit: $tool.py --self-test FAILED"
        echo "$out" | tail -15
        echo
        echo "A gate that does not pass its own self-test cannot be trusted."
        echo "This commit is blocked."
      } >&2
    fi
  done
fi

if [ "$blocked" -eq 1 ]; then
  exit 1
fi
if [ "$warned" -eq 1 ]; then
  echo "pre-commit: warnings above, commit proceeding." >&2
fi
exit 0
