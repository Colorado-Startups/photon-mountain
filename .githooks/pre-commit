#!/usr/bin/env bash
# Photon Mountain pre-commit gate.
#
# ---------------------------------------------------------------------------
# POLICY (decided 2026-09-22, after researching current practice; rerouted
# 2026-10-08 when voice_lint.py was adopted from Claude-OS)
#
#   BLOCK on any FAIL finding from the voice lint.
#     This hook routes; it does not grade. voice_lint.py decides every grade,
#     and pm-check-voice.sh exits 1 only when the lint printed a FAIL. This
#     hook blocks on that exit code and names no check, so a regrade upstream
#     needs no edit here. As of 2026-10-08 the FAIL checks are em-dash and
#     spaced-en-dash: literal character tests with no false positives.
#
#   WARN on every WARN finding.
#     As of 2026-10-08 that is unattributed-figure, ai-tell, hedge-word and
#     sentence-length. voice_lint.py's own docstring calls them heuristics.
#     Blocking on a heuristic trains people to reach for --no-verify, which
#     costs more than it saves.
#
#   FAIL OPEN when the checker itself cannot run.
#     A missing python3 or a missing script warns and lets the commit
#     through. "Could not verify" is not the same as "verified and red".
#
# The rule of thumb behind this split: block on fast, deterministic,
# auto-fixable things; warn on slow or probabilistic ones; put the real gate
# server-side. That last part is why this hook matters more here than it
# would elsewhere. While the repo is private on a Free org, GitHub will not
# let CI be a required check, so this hook is the only gate that actually
# stops anything.
#
# ESCAPE HATCH:  git commit --no-verify
#     Deliberate, documented, and yours. A PreToolUse hook denies that flag
#     to Claude (see .claude/settings.json), so the agent cannot route around
#     the gate while you still can.
#
# ENABLE (once per clone):  git config core.hooksPath .githooks
#
# SELF-TEST:  bash .githooks/pre-commit --self-test
#     Commits seeded files through this hook and checks what blocks and what
#     proceeds. Its call sites are listed where it is defined, below.
# ---------------------------------------------------------------------------

set -uo pipefail

# --------------------------------------------------------------- self-test --
# Each case commits one seeded file in its own throwaway repository. That
# repository holds copies of the four files the voice gate runs on: this hook,
# pm-check-voice.sh, voice_lint.py and voice_exempt.txt. So the test drives the
# real chain through a real `git commit`, and asserts the exit status and the
# finding name the commit printed.
#
# It ships with the hook because a test kept in a scratch directory is not a
# test; the header of .claude/hooks/pm-guard-bypass.sh tells how one was lost.
# Its call sites, as wired:
#   1. .github/workflows/gate-selftests.yml, on a push or pull request that
#      touches .githooks/, .claude/hooks/ or 04_tools/. FIRES.
#   2. Section 3 of this hook, when a commit stages any of the four files.
#      FIRES, once the clone has set core.hooksPath.
#
# Written for the bash 3.2 that ships with macOS: no ${var,,}, no mapfile, no
# associative arrays.
if [ "${1:-}" = "--self-test" ]; then
  src="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

  # Inside a hook, git exports GIT_INDEX_FILE, and in a worktree GIT_DIR too.
  # Left set, every git call below would act on the outer repository's index
  # instead of the throwaway one.
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars)

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  n=0
  failed=0
  out=""
  status=0

  # Commit one file, case.md, in a fresh repository. $1 is its content, with
  # printf %b escapes. Leaves the commit's output in $out and its exit in
  # $status.
  commit_case() {
    n=$((n + 1))
    local repo="$tmp/case$n"
    mkdir -p "$repo/.githooks" "$repo/.claude/hooks" "$repo/04_tools"
    if ! { cp "$src/.githooks/pre-commit" "$repo/.githooks/" &&
           cp "$src/.claude/hooks/pm-check-voice.sh" "$repo/.claude/hooks/" &&
           cp "$src/04_tools/voice_lint.py" "$src/04_tools/voice_exempt.txt" \
              "$repo/04_tools/" &&
           chmod +x "$repo/.githooks/pre-commit"; } 2>/dev/null; then
      out="could not copy the gate files from $src"
      status=99
      return
    fi
    git -C "$repo" init -q
    git -C "$repo" config core.hooksPath .githooks
    git -C "$repo" config user.name "pre-commit self-test"
    git -C "$repo" config user.email "self-test@localhost"
    git -C "$repo" config commit.gpgsign false
    printf '%b' "$1" > "$repo/case.md"
    git -C "$repo" add case.md
    out="$(git -C "$repo" commit -q -m case 2>&1)"
    status=$?
  }

  shows() { printf '%s\n' "$out" | grep -qF -- "$1"; }

  # True when $1 appears below the advisory heading, so it was listed as a
  # warning and not as the reason for a block.
  advises() {
    printf '%s\n' "$out" | sed -n '/advisory, not blocking/,$p' | grep -qF -- "$1"
  }

  # $1 is the case label. $2 is the exit status of the case's assertions.
  verdict() {
    if [ "$2" -eq 0 ]; then
      echo "self-test: $1: OK"
    else
      failed=$((failed + 1))
      echo "self-test: $1: FAIL (commit exited $status)"
      printf '%s\n' "$out" | sed 's/^/    | /'
    fi
  }

  EN='\xe2\x80\x93'  # en dash, U+2013
  EM='\xe2\x80\x94'  # em dash, U+2014

  commit_case "Light moves data $EN and it moves it fast.\n"
  [ "$status" -eq 1 ] && shows '[spaced-en-dash]'
  verdict "a spaced en dash blocks and is named" $?

  commit_case "The corridor is growing $EM and fast.\n"
  [ "$status" -eq 1 ] && shows '[em-dash]'
  verdict "an em dash blocks and is named" $?

  commit_case 'Colorado has 8,000 photonics workers.\n'
  [ "$status" -eq 0 ] && advises '[unattributed-figure]'
  verdict "an unattributed figure proceeds and is listed as advisory" $?

  commit_case "See sections 3${EN}4 for the method.\n"
  [ "$status" -eq 0 ] && ! shows '[spaced-en-dash]'
  verdict "an unspaced range proceeds and is not flagged" $?

  commit_case 'The corridor builds computing on light.\n'
  [ "$status" -eq 0 ] && ! shows 'FAIL [' && ! shows 'WARN ['
  verdict "a clean line proceeds with no finding" $?

  commit_case "Light moves data $EN and it moves it fast.\nColorado has 8,000 photonics workers.\n"
  [ "$status" -eq 1 ] && shows '[spaced-en-dash]' && advises '[unattributed-figure]'
  verdict "a mixed file blocks and still lists the figure as advisory" $?

  # Not UTF-8, so voice_lint.py crashes. That is could-not-verify, which must
  # fail open and say so, never block like a FAIL.
  commit_case 'Not UTF-8: \xff\xfe\n'
  [ "$status" -eq 0 ] && shows 'could not verify'
  verdict "a lint crash proceeds and says it could not verify" $?

  if [ "$failed" -eq 0 ]; then
    echo "self-test: PASS ($n cases)"
    exit 0
  fi
  echo "self-test: FAIL ($failed of $n cases)"
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
VOICE_HOOK="$REPO_ROOT/.claude/hooks/pm-check-voice.sh"

staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0

blocked=0
warned=0

# --- 1. Secret scan -------------------------------------------------------
# gitleaks if it is installed, skipped silently otherwise. The authoritative
# gate is secret-scan.yml in CI; this is the earlier, local warning.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gl_out="$(gitleaks git --staged --no-banner --redact=100 2>&1)"; then
    warned=1
    {
      echo
      echo "=============================================="
      echo "pre-commit: POSSIBLE SECRET in the staged diff"
      echo "=============================================="
      echo "$gl_out" | tail -30
      echo
      echo "Advisory: the commit will proceed. Do NOT push until you have"
      echo "confirmed this is not a real credential. If it is real, unstage"
      echo "it and rotate the secret."
    } >&2
  fi
fi

# --- 2. Voice gate --------------------------------------------------------
# Invoked as `bash <hook>`, never by exec bit, so a checkout or a sync that
# strips the executable bit cannot silently disable the check.
if [ -r "$VOICE_HOOK" ]; then
  # Pass the staged prose through; the hook self-filters by extension.
  prose=()
  while IFS= read -r f; do
    [ -n "$f" ] && prose+=("$REPO_ROOT/$f")
  done <<< "$staged"

  if [ "${#prose[@]}" -gt 0 ]; then
    voice_out="$(bash "$VOICE_HOOK" "${prose[@]}" 2>&1)"
    voice_status=$?
    if [ -n "$voice_out" ]; then
      # Exit 1 blocks. pm-check-voice.sh returns it only for a real FAIL
      # finding, never for a crash. Everything else is advisory.
      if [ "$voice_status" -eq 1 ]; then
        blocked=1
        {
          echo
          echo "========================================"
          echo "pre-commit: voice FAIL in a staged file"
          echo "========================================"
          printf '%s\n' "$voice_out" | grep -E ':[0-9]+: FAIL \['
          echo
          echo "Each finding above says what to change."
          echo
          echo "This commit is blocked. To override anyway:"
          echo "    git commit --no-verify"
        } >&2
      fi
      if printf '%s' "$voice_out" | grep -qE ':[0-9]+: WARN \['; then
        warned=1
        advisories="$(printf '%s\n' "$voice_out" | grep -E ':[0-9]+: WARN \[')"
        total="$(printf '%s\n' "$advisories" | grep -c .)"
        # Cap the dump. A dense revision log can produce ninety warnings in one
        # commit, and a wall of text is not actionable: it buries the one
        # finding worth acting on and teaches people to skip the output. Show
        # unattributed figures first, since those are the ones that matter, then
        # a sample of the rest with a count.
        {
          echo
          echo "pre-commit: $total voice finding(s), advisory, not blocking."
          printf '%s\n' "$advisories" | grep "unattributed-figure" | head -10
          printf '%s\n' "$advisories" | grep -v "unattributed-figure" | head -8
          if [ "$total" -gt 18 ]; then
            echo "    ... and $((total - 18)) more. Full list:"
            echo "    python3 04_tools/voice_lint.py <file>"
          fi
          echo
          echo "Warnings are heuristics, so wave through anything the lint"
          echo "misread. A figure still needs a source or a goal label; the"
          echo "lint warns on it, but the rule does not soften."
        } >&2
      fi
      # The gate's own notices, such as a could-not-verify after a crash. It
      # fails open, so without this line the skip would be silent.
      if printf '%s\n' "$voice_out" | grep -q '^pm-check-voice: '; then
        warned=1
        printf '%s\n' "$voice_out" | grep '^pm-check-voice: ' >&2
      fi
    fi
  fi
else
  echo "pre-commit: $VOICE_HOOK not readable; skipping the voice check." >&2
fi

# --- 3. Gate self-tests, when a gate itself changed -----------------------
# A broken gate is worse than no gate, so if a gate changed, prove it still
# passes its own self-test before the change can land.
if printf '%s' "$staged" | grep -qE "^\.claude/hooks/|^04_tools/voice_exempt\.txt"; then
  for shell_gate in pm-check-voice.sh pm-guard-bypass.sh; do
    script="$REPO_ROOT/.claude/hooks/$shell_gate"
    [ -r "$script" ] || continue
    if ! out="$(bash "$script" --self-test 2>&1)"; then
      blocked=1
      {
        echo
        echo "pre-commit: $shell_gate --self-test FAILED"
        echo "$out" | tail -15
        echo
        echo "A gate that does not pass its own self-test cannot be trusted."
        echo "This commit is blocked."
      } >&2
    fi
  done
fi

# This hook's own self-test runs when any of the four files it copies is
# staged, not only this one. The test drives the whole chain, and the chain
# can break from either end: on 2026-10-08 a regrade in voice_lint.py alone
# would have let a FAIL through this hook unblocked and unprinted. It needs
# python3 for the lint, so without one it is skipped like the tools below.
if printf '%s' "$staged" \
    | grep -qE '^\.githooks/|^\.claude/hooks/pm-check-voice\.sh$|^04_tools/voice_(lint\.py|exempt\.txt)$' \
    && command -v python3 >/dev/null 2>&1; then
  if ! out="$(bash "$REPO_ROOT/.githooks/pre-commit" --self-test 2>&1)"; then
    blocked=1
    {
      echo
      echo "pre-commit: .githooks/pre-commit --self-test FAILED"
      printf '%s\n' "$out" | grep -v ': OK$' | head -40
      echo
      echo "A gate that does not pass its own self-test cannot be trusted."
      echo "This commit is blocked."
    } >&2
  fi
fi

if printf '%s' "$staged" | grep -q "^04_tools/" && command -v python3 >/dev/null 2>&1; then
  for tool in voice_lint brand_tokens marker_parity; do
    script="$REPO_ROOT/04_tools/$tool.py"
    [ -r "$script" ] || continue
    if ! out="$(python3 "$script" --self-test 2>&1)"; then
      blocked=1
      {
        echo
        echo "pre-commit: $tool.py --self-test FAILED"
        echo "$out" | tail -15
        echo
        echo "A gate that does not pass its own self-test cannot be trusted."
        echo "This commit is blocked."
      } >&2
    fi
  done
fi

if [ "$blocked" -eq 1 ]; then
  exit 1
fi
if [ "$warned" -eq 1 ]; then
  echo "pre-commit: warnings above, commit proceeding." >&2
fi
exit 0
